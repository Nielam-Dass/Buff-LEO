{
    "manifest_version": 3,
    "name": "Buff LEO",
    "version": "0.0.1",
    "action": {
        "default_popup": "index.html"
    },
    "content_scripts": [
        {
            "js": ["/assets/contentScript.js"],
            "matches": ["<all_urls>"],
            "all_frames": true
        }
    ]
}
