{
    "manifest_version": 3,
    "name": "Buff LEO",
    "description": "Adds extra features in Tutor.com's Learner Engagements Online (LEO) platform",
    "version": "0.0.2",
    "icons": {
        "16": "images/icon-16.png",
        "32": "images/icon-32.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },
    "action": {
        "default_popup": "index.html"
    },
    "content_scripts": [
        {
            "js": ["/assets/contentScript.js"],
            "matches": ["https://leo.tutor.com/*", "https://v2.tutor.com/*"],
            "all_frames": true
        }
    ]
}
